+import {DiamondTestHelper} from "../../test/helpers/DiamondTestHelper.sol";
+
+/// @notice Development migration: add `StabilityPoolFacet` with mock Liquity pool (#997)
+contract Deploy003_StabilityPool is Script, DiamondTestHelper {
+    uint256 adminPrivateKey;
+    address adminAddress;
+    address diamond;
+
+    function run() public {
+        diamond = vm.envAddress("DIAMOND_ADDRESS");
+        adminPrivateKey = vm.envUint("ADMIN_PRIVATE_KEY");
+        adminAddress = vm.addr(adminPrivateKey);
+
+        MockERC20 lusd = new MockERC20("LUSD", "LUSD", 18);
+        MockERC20 lqty = new MockERC20("LQTY", "LQTY", 18);
+        MockStabilityPool mockPool = new MockStabilityPool(
+            address(lusd),
+            address(lqty)
+        );
+
+        vm.startBroadcast(adminPrivateKey);
+
+        bytes4[] memory selectors = getSelectorsFromAbi(
+            "/out/StabilityPoolFacet.sol/StabilityPoolFacet.json"
+        );
+
+        StabilityPoolFacet implementation = new StabilityPoolFacet();
+
+        FacetCut[] memory cuts = new FacetCut[](1);
+        cuts[0] = FacetCut({
+            facetAddress: address(implementation),
+            action: FacetCutAction.Add,
+            functionSelectors: selectors
+        });
+
+        DiamondCutFacet(diamond).diamondCut(cuts, address(0), "");
+
+        StabilityPoolFacet facet = StabilityPoolFacet(diamond);
+        facet.setStabilityPoolAddress(address(mockPool));
+        facet.setSpTreasuryAddress(adminAddress);
+        facet.setRewardThreshold(0.01 ether);
+
+        vm.stopBroadcast();
+    }
+}
