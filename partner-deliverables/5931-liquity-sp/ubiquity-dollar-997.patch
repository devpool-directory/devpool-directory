@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.19;
+
+import {Script} from "forge-std/Script.sol";
+import {DiamondCutFacet} from "../../src/dollar/facets/DiamondCutFacet.sol";
+import {StabilityPoolFacet} from "../../src/dollar/facets/StabilityPoolFacet.sol";
+import {DiamondTestHelper} from "../../test/helpers/DiamondTestHelper.sol";
+
+/**
+ * @notice Migration: add `StabilityPoolFacet` for Liquity V1 LUSD yield (#997)
+ *
+ * Post-deploy (admin via multisig):
+ * 1. setStabilityPoolAddress(0x66017D22b0f8556afDd19e1e5b5f1cbD89a6C337)
+ * 2. setSpTreasuryAddress(treasury)
+ * 3. setRewardThreshold(0.01 ether) — auto-harvest on redeem when ETH gain exceeds threshold
+ * 4. migrateExistingCollateral(amount) — move idle LUSD already in the diamond into the SP
+ *
+ * Rollback:
+ * 1. togglePause()
+ * 2. withdrawFromPool / emergencyWithdraw
+ * 3. diamondCut remove facet selectors
+ */
+contract Deploy003_StabilityPool is Script, DiamondTestHelper {
+    uint256 ownerPrivateKey;
+    address ownerAddress;
+
+    address diamond = 0xED3084c98148e2528DaDCB53C56352e549C488fA;
+    address ubiquityDeployerAddress =
+        0xefC0e701A824943b469a694aC564Aa1efF7Ab7dd;
+
+    // Liquity V1 mainnet
+    address stabilityPool = 0x66017D22b0F8556aFDd19e1E5B5f1CBD89A6c337;
+    address treasury = 0xefC0e701A824943b469a694aC564Aa1efF7Ab7dd;
+
+    function run() public {
+        ownerPrivateKey = vm.envUint("OWNER_PRIVATE_KEY");
+        ownerAddress = vm.addr(ownerPrivateKey);
+
+        if (ownerAddress == ubiquityDeployerAddress) {
+            vm.startBroadcast(ownerPrivateKey);
+        } else {
+            vm.startBroadcast(ubiquityDeployerAddress);
+        }
+
+        bytes4[] memory selectors = getSelectorsFromAbi(
+            "/out/StabilityPoolFacet.sol/StabilityPoolFacet.json"
+        );
+
+        StabilityPoolFacet implementation = new StabilityPoolFacet();
+
+        FacetCut[] memory cuts = new FacetCut[](1);
+        cuts[0] = FacetCut({
+            facetAddress: address(implementation),
+            action: FacetCutAction.Add,
+            functionSelectors: selectors
+        });
+
+        DiamondCutFacet(diamond).diamondCut(cuts, address(0), "");
+
+        StabilityPoolFacet facet = StabilityPoolFacet(diamond);
+        facet.setStabilityPoolAddress(stabilityPool);
+        facet.setSpTreasuryAddress(treasury);
+        facet.setRewardThreshold(0.01 ether);
+
+        vm.stopBroadcast();
+    }
+}
