@@ -0,0 +1,284 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.19;
+
+import {DiamondTestSetup} from "../DiamondTestSetup.sol";
+import {MockStabilityPool} from "../../../src/dollar/mocks/MockStabilityPool.sol";
+import {MockERC20} from "../../../src/dollar/mocks/MockERC20.sol";
+import {MockChainLinkFeed} from "../../../src/dollar/mocks/MockChainLinkFeed.sol";
+import {MockCurveStableSwapNG} from "../../../src/dollar/mocks/MockCurveStableSwapNG.sol";
+import {MockCurveTwocryptoOptimized} from "../../../src/dollar/mocks/MockCurveTwocryptoOptimized.sol";
+
+contract StabilityPoolFacetTest is DiamondTestSetup {
+    MockStabilityPool mockStabilityPool;
+    MockERC20 lusdToken;
+    MockERC20 lqtyToken;
+    MockChainLinkFeed collateralTokenPriceFeed;
+    MockChainLinkFeed ethUsdPriceFeed;
+    MockChainLinkFeed stableUsdPriceFeed;
+    MockCurveStableSwapNG curveDollarPlainPool;
+    MockCurveTwocryptoOptimized curveGovernanceEthPool;
+    MockERC20 stableToken;
+    MockERC20 wethToken;
+
+    address treasury = address(0x999);
+    address user = address(0x1001);
+
+    function setUp() public override {
+        super.setUp();
+
+        lusdToken = new MockERC20("LUSD", "LUSD", 18);
+        lqtyToken = new MockERC20("LQTY", "LQTY", 18);
+        mockStabilityPool = new MockStabilityPool(
+            address(lusdToken),
+            address(lqtyToken)
+        );
+
+        vm.startPrank(admin);
+        stabilityPoolFacet.setStabilityPoolAddress(address(mockStabilityPool));
+        stabilityPoolFacet.setSpTreasuryAddress(treasury);
+        stabilityPoolFacet.setRewardThreshold(0.01 ether);
+        vm.stopPrank();
+
+        _setupUbiquityPoolWithLusdCollateral();
+    }
+
+    function _setupUbiquityPoolWithLusdCollateral() internal {
+        collateralTokenPriceFeed = new MockChainLinkFeed();
+        ethUsdPriceFeed = new MockChainLinkFeed();
+        stableUsdPriceFeed = new MockChainLinkFeed();
+        wethToken = new MockERC20("WETH", "WETH", 18);
+        stableToken = new MockERC20("STABLE", "STABLE", 18);
+        curveDollarPlainPool = new MockCurveStableSwapNG(
+            address(stableToken),
+            address(dollarToken)
+        );
+        curveGovernanceEthPool = new MockCurveTwocryptoOptimized(
+            address(governanceToken),
+            address(wethToken)
+        );
+
+        vm.startPrank(admin);
+        ubiquityPoolFacet.addCollateralToken(
+            address(lusdToken),
+            address(collateralTokenPriceFeed),
+            1_000_000e18
+        );
+
+        collateralTokenPriceFeed.updateMockParams(
+            1,
+            100_000_000,
+            block.timestamp,
+            block.timestamp,
+            1
+        );
+        ethUsdPriceFeed.updateMockParams(
+            1,
+            2000_00000000,
+            block.timestamp,
+            block.timestamp,
+            1
+        );
+        stableUsdPriceFeed.updateMockParams(
+            1,
+            100_000_000,
+            block.timestamp,
+            block.timestamp,
+            1
+        );
+        curveGovernanceEthPool.updateMockParams(20_000e18);
+
+        ubiquityPoolFacet.setCollateralChainLinkPriceFeed(
+            address(lusdToken),
+            address(collateralTokenPriceFeed),
+            1 days
+        );
+        ubiquityPoolFacet.setEthUsdChainLinkPriceFeed(
+            address(ethUsdPriceFeed),
+            1 days
+        );
+        ubiquityPoolFacet.setStableUsdChainLinkPriceFeed(
+            address(stableUsdPriceFeed),
+            1 days
+        );
+        ubiquityPoolFacet.setGovernanceEthPoolAddress(
+            address(curveGovernanceEthPool)
+        );
+        ubiquityPoolFacet.setCollateralRatio(1_000_000);
+        ubiquityPoolFacet.setPriceThresholds(990_000, 1_010_000);
+        ubiquityPoolFacet.setRedemptionDelayBlocks(1);
+        ubiquityPoolFacet.toggleCollateral(0);
+        managerFacet.setStableSwapPlainPoolAddress(
+            address(curveDollarPlainPool)
+        );
+        vm.stopPrank();
+    }
+
+    function test_DepositAndWithdraw() public {
+        uint256 amount = 1000e18;
+        lusdToken.mint(user, amount);
+        vm.startPrank(user);
+        lusdToken.approve(address(diamond), amount);
+        stabilityPoolFacet.depositToPool(amount);
+        vm.stopPrank();
+
+        assertEq(stabilityPoolFacet.totalPrincipalInPool(), amount);
+        assertEq(lusdToken.balanceOf(address(mockStabilityPool)), amount);
+
+        vm.prank(user);
+        stabilityPoolFacet.withdrawFromPool(amount);
+
+        assertEq(stabilityPoolFacet.totalPrincipalInPool(), 0);
+        assertEq(lusdToken.balanceOf(user), amount);
+    }
+
+    function test_HarvestRewards() public {
+        uint256 amount = 500e18;
+        lusdToken.mint(user, amount);
+        vm.startPrank(user);
+        lusdToken.approve(address(diamond), amount);
+        stabilityPoolFacet.depositToPool(amount);
+        vm.stopPrank();
+
+        mockStabilityPool.setETHGain(address(diamond), 1 ether);
+        mockStabilityPool.setLQTYGain(address(diamond), 25e18);
+        lqtyToken.mint(address(mockStabilityPool), 25e18);
+        vm.deal(address(mockStabilityPool), 1 ether);
+
+        stabilityPoolFacet.harvestRewards();
+
+        assertEq(lqtyToken.balanceOf(treasury), 25e18);
+        assertEq(treasury.balance, 1 ether);
+    }
+
+    function test_PausedBlocksDeposit() public {
+        vm.prank(admin);
+        stabilityPoolFacet.togglePause();
+
+        lusdToken.mint(user, 100e18);
+        vm.startPrank(user);
+        lusdToken.approve(address(diamond), 100e18);
+        vm.expectRevert("StabilityPool: paused");
+        stabilityPoolFacet.depositToPool(100e18);
+        vm.stopPrank();
+    }
+
+    function testFuzz_DepositWithdraw(uint256 amount) public {
+        amount = bound(amount, 1e18, 900e18);
+        lusdToken.mint(user, amount);
+        vm.startPrank(user);
+        lusdToken.approve(address(diamond), amount);
+        stabilityPoolFacet.depositToPool(amount);
+        stabilityPoolFacet.withdrawFromPool(amount);
+        vm.stopPrank();
+        assertEq(stabilityPoolFacet.totalPrincipalInPool(), 0);
+    }
+
+    function test_GasMintHookOverheadUnderLimit() public {
+        uint256 mintAmount = 100e6;
+        uint256 collateralNeeded = 100e6;
+        lusdToken.mint(user, collateralNeeded * 2);
+        vm.startPrank(user);
+        lusdToken.approve(address(diamond), collateralNeeded * 2);
+
+        vm.stopPrank();
+        vm.prank(admin);
+        stabilityPoolFacet.togglePause();
+
+        vm.startPrank(user);
+        uint256 gasBefore = gasleft();
+        ubiquityPoolFacet.mintDollar(
+            0,
+            mintAmount,
+            mintAmount,
+            collateralNeeded,
+            0,
+            true
+        );
+        uint256 gasWithoutYield = gasBefore - gasleft();
+        vm.stopPrank();
+
+        vm.prank(admin);
+        stabilityPoolFacet.togglePause();
+
+        vm.startPrank(user);
+        gasBefore = gasleft();
+        ubiquityPoolFacet.mintDollar(
+            0,
+            mintAmount,
+            mintAmount,
+            collateralNeeded,
+            0,
+            true
+        );
+        uint256 gasWithYield = gasBefore - gasleft();
+        vm.stopPrank();
+
+        assertLt(
+            gasWithYield - gasWithoutYield,
+            200_000,
+            "mint SP hook overhead too high"
+        );
+    }
+
+    function test_MintDepositsToStabilityPool() public {
+        uint256 mintAmount = 1000e6;
+        uint256 collateralNeeded = 1000e6;
+
+        lusdToken.mint(user, collateralNeeded);
+        vm.startPrank(user);
+        lusdToken.approve(address(diamond), collateralNeeded);
+        ubiquityPoolFacet.mintDollar(
+            0,
+            mintAmount,
+            mintAmount,
+            collateralNeeded,
+            0,
+            true
+        );
+        vm.stopPrank();
+
+        assertEq(stabilityPoolFacet.totalPrincipalInPool(), collateralNeeded);
+        assertEq(
+            mockStabilityPool.getCompoundedLUSDDeposit(address(diamond)),
+            collateralNeeded
+        );
+        assertEq(lusdToken.balanceOf(address(diamond)), 0);
+    }
+
+    function test_RedeemWithdrawsFromStabilityPool() public {
+        uint256 mintAmount = 1000e6;
+        uint256 collateralNeeded = 1000e6;
+        lusdToken.mint(user, collateralNeeded);
+        vm.startPrank(user);
+        lusdToken.approve(address(diamond), collateralNeeded);
+        ubiquityPoolFacet.mintDollar(
+            0,
+            mintAmount,
+            mintAmount,
+            collateralNeeded,
+            0,
+            true
+        );
+        dollarToken.approve(address(diamond), mintAmount);
+        ubiquityPoolFacet.redeemDollar(0, mintAmount, 0, 0);
+        vm.stopPrank();
+
+        vm.roll(block.number + 2);
+        vm.prank(user);
+        ubiquityPoolFacet.collectRedemption(0);
+
+        assertEq(stabilityPoolFacet.totalPrincipalInPool(), 0);
+        assertEq(lusdToken.balanceOf(user), collateralNeeded);
+    }
+
+    function test_MigrateExistingCollateral() public {
+        uint256 amount = 500e18;
+        lusdToken.mint(address(diamond), amount);
+
+        vm.prank(admin);
+        stabilityPoolFacet.migrateExistingCollateral(amount);
+
+        assertEq(stabilityPoolFacet.totalPrincipalInPool(), amount);
+        assertEq(lusdToken.balanceOf(address(diamond)), 0);
+    }
+}
