+pragma solidity 0.8.19;
+
+/// @notice Interface for the Stability Pool Facet (Liquity V1 LUSD yield)
+interface IStabilityPoolFacet {
+    event DepositedToPool(address indexed sender, uint256 amount);
+    event WithdrawnFromPool(address indexed sender, uint256 amount);
+    event RewardsHarvested(
+        address indexed sender,
+        uint256 ethReward,
+        uint256 lqtyReward
+    );
+    event StabilityPoolAddressSet(address indexed stabilityPool);
+    event RewardThresholdSet(uint256 threshold);
+    event SpTreasuryAddressSet(address indexed treasury);
+    event StabilityPoolPaused(bool paused);
+
+    function stabilityPoolAddress() external view returns (address);
+
+    function totalPrincipalInPool() external view returns (uint256);
+
+    function rewardThreshold() external view returns (uint256);
+
+    function spTreasuryAddress() external view returns (address);
+
+    function isStabilityPoolPaused() external view returns (bool);
+
+    function getDepositedLUSD() external view returns (uint256);
+
+    function getPendingETHReward() external view returns (uint256);
+
+    function getPendingLQTYReward() external view returns (uint256);
+
+    function depositToPool(uint256 amount) external;
+
+    function withdrawFromPool(uint256 amount) external;
+
+    function harvestRewards() external;
+
+    function migrateExistingCollateral(uint256 amount) external;
+
+    function setStabilityPoolAddress(address _stabilityPool) external;
+
+    function setRewardThreshold(uint256 _threshold) external;
+
+    function setSpTreasuryAddress(address _treasury) external;
+
+    function togglePause() external;
+
+    function emergencyWithdraw(address token, uint256 amount) external;
+}
diff --git a/packages/contracts/src/dollar/libraries/LibStabilityPool.sol b/packages/contracts/src/dollar/libraries/LibStabilityPool.sol
new file mode 100644
index 0000000..3505004
--- /dev/null
+++ b/packages/contracts/src/dollar/libraries/LibStabilityPool.sol
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+pragma solidity 0.8.19;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {IStabilityPool} from "../interfaces/IStabilityPool.sol";
+
+/// @notice Library for Liquity V1 Stability Pool integration (#997)
+/// @dev Uses an isolated storage slot; hooks are called from LibUbiquityPool on mint/redeem.
+library LibStabilityPool {
+    using SafeERC20 for IERC20;
+
+    bytes32 constant STABILITY_POOL_STORAGE_POSITION =
+        bytes32(
+            uint256(keccak256("ubiquity.contracts.stability.pool.storage")) -
+                1
+        ) & ~bytes32(uint256(0xff));
+
+    struct StabilityPoolStorage {
+        address stabilityPool;
+        address lusdToken;
+        address lqtyToken;
+        address treasury;
+        uint256 totalPrincipalInPool;
+        uint256 rewardThreshold;
+        bool paused;
+    }
+
+    event DepositedToPool(address indexed sender, uint256 amount);
+    event WithdrawnFromPool(address indexed sender, uint256 amount);
+    event RewardsHarvested(
+        address indexed sender,
+        uint256 ethReward,
+        uint256 lqtyReward
+    );
+    event StabilityPoolAddressSet(address indexed stabilityPool);
+    event RewardThresholdSet(uint256 threshold);
+    event SpTreasuryAddressSet(address indexed treasury);
+    event StabilityPoolPaused(bool paused);
+
+    function stabilityPoolStorage()
+        internal
+        pure
+        returns (StabilityPoolStorage storage sps)
+    {
+        bytes32 position = STABILITY_POOL_STORAGE_POSITION;
+        assembly {
+            sps.slot := position
+        }
+    }
+
+    function isConfigured() internal view returns (bool) {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        return sps.stabilityPool != address(0) && sps.lusdToken != address(0);
+    }
+
+    function isYieldActiveFor(address collateralAddress)
+        internal
+        view
+        returns (bool)
+    {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        return
+            isConfigured() &&
+            !sps.paused &&
+            collateralAddress == sps.lusdToken;
+    }
+
+  /// @notice LUSD held in the stability pool counts toward free collateral.
+    function collateralInPool() internal view returns (uint256) {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        if (!isConfigured() || sps.paused) {
+            return 0;
+        }
+        return
+            IStabilityPool(sps.stabilityPool).getCompoundedLUSDDeposit(
+                address(this)
+            );
+    }
+
+    function depositOnMint(
+        address collateralAddress,
+        uint256 amount
+    ) internal {
+        if (amount == 0 || !isYieldActiveFor(collateralAddress)) {
+            return;
+        }
+        _deposit(amount, msg.sender);
+    }
+
+    function withdrawForRedeem(
+        address collateralAddress,
+        uint256 amount
+    ) internal {
+        if (amount == 0 || !isYieldActiveFor(collateralAddress)) {
+            return;
+        }
+        _withdraw(amount, msg.sender);
+        _maybeHarvestOnRedeem();
+    }
+
+    function depositToPool(uint256 amount) internal {
+        require(amount > 0, "StabilityPool: zero amount");
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        require(!sps.paused, "StabilityPool: paused");
+        require(sps.stabilityPool != address(0), "StabilityPool: not set");
+
+        IERC20(sps.lusdToken).safeTransferFrom(
+            msg.sender,
+            address(this),
+            amount
+        );
+        _deposit(amount, msg.sender);
+    }
+
+    function withdrawFromPool(uint256 amount) internal {
+        require(amount > 0, "StabilityPool: zero amount");
+        require(!stabilityPoolStorage().paused, "StabilityPool: paused");
+        uint256 received = _withdraw(amount, msg.sender);
+        if (received > 0) {
+            IERC20(stabilityPoolStorage().lusdToken).safeTransfer(
+                msg.sender,
+                received
+            );
+        }
+        _maybeHarvestOnRedeem();
+    }
+
+    function harvestRewards() internal {
+        _harvestRewards(msg.sender);
+    }
+
+    /// @notice Move idle LUSD already in the diamond into the stability pool (admin migration)
+    function migrateExistingCollateral(uint256 amount) internal {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        require(!sps.paused, "StabilityPool: paused");
+        require(isConfigured(), "StabilityPool: not set");
+        require(amount > 0, "StabilityPool: zero amount");
+
+        uint256 balance = IERC20(sps.lusdToken).balanceOf(address(this));
+        uint256 toDeposit = amount > balance ? balance : amount;
+        if (toDeposit == 0) {
+            return;
+        }
+        _deposit(toDeposit, msg.sender);
+    }
+
+    function setStabilityPoolAddress(address _stabilityPool) internal {
+        require(_stabilityPool != address(0), "StabilityPool: zero address");
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        sps.stabilityPool = _stabilityPool;
+        sps.lusdToken = IStabilityPool(_stabilityPool).LUSD();
+        sps.lqtyToken = IStabilityPool(_stabilityPool).lqtyToken();
+        emit StabilityPoolAddressSet(_stabilityPool);
+    }
+
+    function setRewardThreshold(uint256 _threshold) internal {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        sps.rewardThreshold = _threshold;
+        emit RewardThresholdSet(_threshold);
+    }
+
+    function setTreasuryAddress(address _treasury) internal {
+        require(_treasury != address(0), "StabilityPool: zero address");
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        sps.treasury = _treasury;
+        emit SpTreasuryAddressSet(_treasury);
+    }
+
+    function togglePause() internal {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        sps.paused = !sps.paused;
+        emit StabilityPoolPaused(sps.paused);
+    }
+
+    function emergencyWithdraw(address token, uint256 amount) internal {
+        IERC20(token).safeTransfer(msg.sender, amount);
+    }
+
+    function getDepositedLUSD() internal view returns (uint256) {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        if (!isConfigured()) {
+            return 0;
+        }
+        return
+            IStabilityPool(sps.stabilityPool).getCompoundedLUSDDeposit(
+                address(this)
+            );
+    }
+
+    function getPendingETHReward() internal view returns (uint256) {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        if (!isConfigured()) {
+            return 0;
+        }
+        return
+            IStabilityPool(sps.stabilityPool).getDepositorETHGain(
+                address(this)
+            );
+    }
+
+    function getPendingLQTYReward() internal view returns (uint256) {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        if (!isConfigured()) {
+            return 0;
+        }
+        return
+            IStabilityPool(sps.stabilityPool).getDepositorLQTYGain(
+                address(this)
+            );
+    }
+
+    function _deposit(uint256 amount, address sender) private {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        require(sps.stabilityPool != address(0), "StabilityPool: not set");
+
+        IERC20(sps.lusdToken).safeIncreaseAllowance(
+            sps.stabilityPool,
+            amount
+        );
+        IStabilityPool(sps.stabilityPool).provideToSP(amount, address(0));
+
+        sps.totalPrincipalInPool += amount;
+        emit DepositedToPool(sender, amount);
+    }
+
+    function _withdraw(uint256 amount, address sender) private returns (uint256 received) {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        require(sps.stabilityPool != address(0), "StabilityPool: not set");
+        require(
+            amount <= sps.totalPrincipalInPool,
+            "StabilityPool: exceeds principal"
+        );
+
+        IERC20 lusd = IERC20(sps.lusdToken);
+        uint256 balanceBefore = lusd.balanceOf(address(this));
+
+        IStabilityPool(sps.stabilityPool).withdrawFromSP(amount);
+
+        received = lusd.balanceOf(address(this)) - balanceBefore;
+        uint256 principalReduction = received > 0 ? received : amount;
+        if (principalReduction > sps.totalPrincipalInPool) {
+            sps.totalPrincipalInPool = 0;
+        } else {
+            sps.totalPrincipalInPool -= principalReduction;
+        }
+
+        emit WithdrawnFromPool(sender, principalReduction);
+    }
+
+    function _maybeHarvestOnRedeem() private {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        if (!isConfigured() || sps.treasury == address(0)) {
+            return;
+        }
+
+        uint256 ethReward = IStabilityPool(sps.stabilityPool)
+            .getDepositorETHGain(address(this));
+        if (ethReward >= sps.rewardThreshold) {
+            _harvestRewards(msg.sender);
+        }
+    }
+
+    function _harvestRewards(address sender) private {
+        StabilityPoolStorage storage sps = stabilityPoolStorage();
+        require(sps.stabilityPool != address(0), "StabilityPool: not set");
+        require(sps.treasury != address(0), "StabilityPool: treasury not set");
+
+        uint256 ethReward = IStabilityPool(sps.stabilityPool)
+            .getDepositorETHGain(address(this));
+        uint256 lqtyReward = IStabilityPool(sps.stabilityPool)
+            .getDepositorLQTYGain(address(this));
+
+        if (ethReward == 0 && lqtyReward == 0) {
+            return;
+        }
+
+        // Liquity V1: withdrawFromSP(0) claims ETH/LQTY gains without withdrawing principal.
+        IStabilityPool(sps.stabilityPool).withdrawFromSP(0);
+
+        if (ethReward > 0) {
+            (bool success, ) = sps.treasury.call{value: ethReward}("");
+            require(success, "StabilityPool: ETH transfer failed");
+        }
+
+        if (lqtyReward > 0) {
+            IERC20(sps.lqtyToken).safeTransfer(sps.treasury, lqtyReward);
+        }
+
+        emit RewardsHarvested(sender, ethReward, lqtyReward);
+    }
+}
