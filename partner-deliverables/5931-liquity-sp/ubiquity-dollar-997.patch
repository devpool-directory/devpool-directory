@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.19;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {MockERC20} from "./MockERC20.sol";
+
+/// @notice 1:1 mock router for Stability Pool reward routing tests
+contract MockUniswapV2Router {
+    function swapExactETHForTokens(
+        uint256 /* amountOutMin */,
+        address[] calldata path,
+        address to,
+        uint256 /* deadline */
+    ) external payable returns (uint256[] memory amounts) {
+        uint256 out = msg.value;
+        MockERC20(path[1]).mint(to, out);
+        amounts = new uint256[](2);
+        amounts[0] = msg.value;
+        amounts[1] = out;
+    }
+
+    function swapExactTokensForTokens(
+        uint256 amountIn,
+        uint256 /* amountOutMin */,
+        address[] calldata path,
+        address to,
+        uint256 /* deadline */
+    ) external returns (uint256[] memory amounts) {
+        IERC20(path[0]).transferFrom(msg.sender, address(this), amountIn);
+        IERC20 tokenOut = IERC20(path[1]);
+        uint256 poolBalance = tokenOut.balanceOf(address(this));
+        if (poolBalance >= amountIn) {
+            tokenOut.transfer(to, amountIn);
+        } else {
+            MockERC20(path[1]).mint(to, amountIn);
+        }
+        amounts = new uint256[](2);
+        amounts[0] = amountIn;
+        amounts[1] = amountIn;
+    }
+}
