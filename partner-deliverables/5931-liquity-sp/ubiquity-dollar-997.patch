+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {IStabilityPool} from "../../../src/dollar/interfaces/IStabilityPool.sol";
+
+/// @notice Mainnet fork smoke test for Liquity V1 Stability Pool interface (#997)
+/// @dev Skips gracefully when fork RPC is unavailable or returns empty state.
+contract StabilityPoolForkTest is Test {
+    address constant STABILITY_POOL =
+        0x66017D22b0F8556aFDd19e1E5B5f1CBD89A6c337;
+    address constant LUSD = 0x5f98805A4E8be255a32880FDeC7F6728C6568bA0;
+
+    function _forkUnavailable() internal view returns (bool) {
+        return STABILITY_POOL.code.length == 0;
+    }
+
+    function test_Fork_LiquityDepositAndWithdraw() public {
+        vm.createSelectFork("mainnet");
+        if (_forkUnavailable()) {
+            return;
+        }
+
+        IStabilityPool sp = IStabilityPool(STABILITY_POOL);
+        assertEq(sp.LUSD(), LUSD);
+        assertTrue(sp.lqtyToken() != address(0));
+
+        uint256 amount = 1e18;
+        deal(LUSD, address(this), amount);
+
+        IERC20(LUSD).approve(STABILITY_POOL, amount);
+        sp.provideToSP(amount, address(0));
+
