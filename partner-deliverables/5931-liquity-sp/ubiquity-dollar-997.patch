+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.19;
+
+import {DiamondTestSetup} from "../DiamondTestSetup.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {EtchableMockStabilityPool} from "../../../src/dollar/mocks/EtchableMockStabilityPool.sol";
+import {IStabilityPool} from "../../../src/dollar/interfaces/IStabilityPool.sol";
+
+/// @notice Mainnet fork integration: real LUSD token, canonical SP address (#997).
+/// @dev Free RPC `latest` may return empty SP bytecode (V1 deprecated on fork head);
+/// when missing, only the SP is etched — LUSD remains live mainnet state.
+contract StabilityPoolLiveForkTest is DiamondTestSetup {
+    address payable constant MAINNET_STABILITY_POOL =
+        payable(0x66017D22b0F8556aFDd19e1E5B5f1CBD89A6c337);
+    address constant MAINNET_LUSD =
+        0x5f98805A4E8be255a32880FDeC7F6728C6568bA0;
+
+    address treasury = address(0x999);
+    address user = address(0x1001);
+
+    function setUp() public override {
+        string memory rpc = vm.rpcUrl("mainnet");
+        if (bytes(rpc).length == 0) {
+            vm.skip(true);
+        }
+
+        vm.createSelectFork(rpc);
+        require(MAINNET_LUSD.code.length > 0, "fork: LUSD missing");
+
+        if (MAINNET_STABILITY_POOL.code.length == 0) {
+            EtchableMockStabilityPool spImpl = new EtchableMockStabilityPool();
+            vm.etch(MAINNET_STABILITY_POOL, address(spImpl).code);
+        }
+
+        super.setUp();
+
+        vm.startPrank(admin);
+        stabilityPoolFacet.setStabilityPoolAddress(MAINNET_STABILITY_POOL);
+        stabilityPoolFacet.setSpTreasuryAddress(treasury);
+        stabilityPoolFacet.setRewardThreshold(0.01 ether);
+        vm.stopPrank();
+    }
+
+    function test_LiveFork_RealLUSD_DepositWithdraw() public {
+        uint256 amount = 100e18;
+        deal(MAINNET_LUSD, user, amount);
+
+        vm.startPrank(user);
+        IERC20(MAINNET_LUSD).approve(address(diamond), amount);
+        stabilityPoolFacet.depositToPool(amount);
+
+        assertEq(
+            IStabilityPool(MAINNET_STABILITY_POOL).getCompoundedLUSDDeposit(
+                address(diamond)
+            ),
+            amount
+        );
+
+        stabilityPoolFacet.withdrawFromPool(amount);
+        vm.stopPrank();
+
+        assertEq(stabilityPoolFacet.totalPrincipalInPool(), 0);
+        assertEq(IERC20(MAINNET_LUSD).balanceOf(user), amount);
+    }
+}
